# Maintainer: JDB321Sailor <https://github.com/JDB321Sailor>
# llama.cpp built with the ROCm/HIP backend (AMD iGPU + dGPU).
# Tracks the latest upstream tag from github.com/ggml-org/llama.cpp.

pkgname=llama.cpp-rocm
pkgver=0  # overwritten by pkgver() at build time
pkgrel=1
pkgdesc="llama.cpp inference engine — ROCm/HIP backend (multi-arch fat binary)"
arch=('x86_64')
url="https://github.com/ggml-org/llama.cpp"
license=('MIT')

depends=(
  'rocm-hip-runtime'
  'rocblas'
  'hipblas'
  'hipblaslt'
)

makedepends=(
  'git'
  'cmake'
  'ninja'
  'rocm-hip-sdk'
  'hip-runtime-amd'
  'rocm-llvm'
  'rocminfo'
  'rocblas'
  'hipblas'
  'hipblaslt'
)

provides=('llama.cpp')
conflicts=('llama.cpp' 'llama.cpp-cuda' 'llama.cpp-vulkan')

options=(!strip !lto)

source=("llama.cpp::git+https://github.com/ggml-org/llama.cpp.git")
sha256sums=('SKIP')

pkgver() {
  cd "${srcdir}/llama.cpp"
  # Use the most recent upstream tag (e.g. b5210), falling back to commit count.
  git describe --tags --abbrev=0 2>/dev/null \
    | sed 's/^[bBvV]//' \
    || printf 'r%s' "$(git rev-list --count HEAD)"
}

# Print the ROCm prefix that ships the HIP headers. Arch installs them under
# /opt/rocm, which is only added to PATH by /etc/profile.d/rocm.sh in new
# login shells — so hipconfig/rocminfo are invisible right after installing
# the ROCm packages unless we resolve the prefix ourselves.
_rocm_prefix() {
  local _candidate
  for _candidate in "${ROCM_PATH:-}" "${HIP_PATH:-}" /opt/rocm /usr; do
    [ -n "${_candidate}" ] || continue
    if [ -r "${_candidate}/include/hip/hip_runtime.h" ]; then
      printf '%s' "${_candidate}"
      return 0
    fi
  done
  return 1
}

_detect_arches() {
  local _default='gfx1100 gfx1151'
  [ -n "${ROCM_ARCH:-}" ] && { printf '%s' "${ROCM_ARCH//,/ }"; return; }
  if command -v rocminfo >/dev/null 2>&1; then
    local _det
    _det="$(rocminfo 2>/dev/null \
      | awk 'BEGIN{gpu=0;name=""}
             /^[[:space:]]*Agent[[:space:]]+[0-9]+/{if(gpu&&name!="")print name;gpu=0;name="";next}
             /^[[:space:]]*Type:[[:space:]]*GPU/{gpu=1;next}
             {if($0~/^[[:space:]]*Name:[[:space:]]*gfx[0-9A-Fa-f]+[[:space:]]*$/){
               n=$0;sub(/^[[:space:]]*Name:[[:space:]]*/,"",n);sub(/[[:space:]]*$/,"",n);name=tolower(n)}}
             END{if(gpu&&name!="")print name}' \
      | sort -u | tr '\n' ' ')"
    _det="${_det%[[:space:]]}"
    [ -n "$_det" ] && { printf '%s' "$_det"; return; }
  fi
  printf '%s' "$_default"
}

build() {
  cd "${srcdir}/llama.cpp"

  local _prefix
  if ! _prefix="$(_rocm_prefix)"; then
    error "llama.cpp-rocm: HIP headers (include/hip/hip_runtime.h) not found in \$ROCM_PATH, \$HIP_PATH, /opt/rocm or /usr."
    error "llama.cpp-rocm: install them with 'pacman -S --needed rocm-hip-sdk hip-runtime-amd', or set ROCM_PATH to your ROCm prefix."
    return 1
  fi

  export ROCM_PATH="${_prefix}"
  export HIP_PATH="${_prefix}"
  export PATH="${_prefix}/bin:${PATH}"

  # hipconfig is in ${_prefix}/bin, which is now on PATH; keep the standard
  # ROCm layout as a fallback in case hipconfig is unavailable.
  local _hip_clang_path
  _hip_clang_path="$(hipconfig --hipclangpath 2>/dev/null || true)"
  [ -n "${_hip_clang_path}" ] || _hip_clang_path="${_prefix}/lib/llvm/bin"

  local _arches _arch _offload_flags=()
  _arches="$(_detect_arches)"
  for _arch in $_arches; do
    _offload_flags+=("-DAMDGPU_TARGETS=${_arch}")
  done
  # CMake expects a semicolon-separated list for AMDGPU_TARGETS.
  local _targets
  _targets="$(printf '%s\n' $_arches | tr ' ' ';')"

  cmake -S . -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DGGML_HIPBLAS=ON \
    -DAMDGPU_TARGETS="${_targets}" \
    -DCMAKE_HIP_COMPILER="${_hip_clang_path}/clang++" \
    -DGGML_NATIVE=OFF

  cmake --build build -- -j"$(nproc)"
}

package() {
  cd "${srcdir}/llama.cpp"
  DESTDIR="${pkgdir}" cmake --install build
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
