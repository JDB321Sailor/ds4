# Maintainer: JDB321Sailor <https://github.com/JDB321Sailor>
# llama.cpp built with the CUDA backend (Nvidia eGPU).
# Tracks the latest upstream tag from github.com/ggml-org/llama.cpp.

pkgname=llama.cpp-cuda
pkgver=0  # overwritten by pkgver() at build time
pkgrel=1
pkgdesc="llama.cpp inference engine — CUDA backend (Nvidia GPU)"
arch=('x86_64')
url="https://github.com/ggml-org/llama.cpp"
license=('MIT')

depends=(
  'cuda'
)

makedepends=(
  'git'
  'cmake'
  'ninja'
  'cuda'
  'gcc'
)

provides=('llama.cpp')
conflicts=('llama.cpp' 'llama.cpp-rocm' 'llama.cpp-vulkan')

options=(!strip !lto)

source=("llama.cpp::git+https://github.com/ggml-org/llama.cpp.git")
sha256sums=('SKIP')

pkgver() {
  cd "${srcdir}/llama.cpp"
  git describe --tags --abbrev=0 2>/dev/null \
    | sed 's/^[bBvV]//' \
    || printf 'r%s' "$(git rev-list --count HEAD)"
}

build() {
  cd "${srcdir}/llama.cpp"

  local _cuda_root="${CUDAToolkit_ROOT:-${CUDA_PATH:-/opt/cuda}}"
  local _cuda_compiler="${_cuda_root}/bin/nvcc"
  if [[ ! -x "${_cuda_compiler}" ]]; then
    printf 'ERROR: CUDA compiler not found at %s\n' "${_cuda_compiler}" >&2
    return 1
  fi
  export PATH="${_cuda_root}/bin:${PATH}"

  cmake -S . -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCUDAToolkit_ROOT="${_cuda_root}" \
    -DCMAKE_CUDA_COMPILER="${_cuda_compiler}" \
    -DGGML_CUDA=ON \
    -DGGML_NATIVE=OFF

  cmake --build build -- -j"$(nproc)"
}

package() {
  cd "${srcdir}/llama.cpp"
  DESTDIR="${pkgdir}" cmake --install build
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
